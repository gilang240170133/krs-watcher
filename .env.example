# Salin file ini jadi ".env" untuk development lokal.
# Di Railway, JANGAN upload file .env -- isi nilai-nilai ini lewat
# tab "Variables" di project Railway kamu.

# --- Kredensial portal kampus ---
PORTAL_USERNAME=nim_kamu
PORTAL_PASSWORD=password_portal_kamu

# --- Bot Telegram untuk kirim notifikasi ---
# Buat bot lewat @BotFather, lalu ambil chat_id lewat @userinfobot
TELEGRAM_BOT_TOKEN=123456:ABC-isi-dengan-token-asli
TELEGRAM_CHAT_ID=123456789

# --- Password buat dashboard web (SANGAT disarankan diisi) ---
WEB_UI_PASSWORD=ganti-dengan-password-kamu
FLASK_SECRET_KEY=ganti-dengan-string-acak-panjang

# --- Opsional, sudah ada default masing-masing ---
# POLL_MIN_SECONDS=30
# POLL_MAX_SECONDS=60
# REMINDER_INTERVAL_SECONDS=120
# REQUEST_TIMEOUT_SECONDS=30
# STATE_FILE=notify_state.json
# TARGETS_FILE=targets.json
# LOG_FILE=krs_watcher.log
